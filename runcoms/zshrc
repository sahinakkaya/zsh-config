crontab() {
  if [[ "$1" == "-r" ]]; then
    local counter_file="${ZDOTDIR:-$HOME}/.crontab-counter"
    local count=0

    [[ -r "$counter_file" ]] && read -r count < "$counter_file"
    [[ "$count" == <-> ]] || count=0
    (( count += 1 ))
    printf '%s\n' "$count" >! "$counter_file"

    print -r -- 'Refusing to run crontab -r'
    print -r -- 'Use: crontab -l > backup && crontab -e'
    print -r -- ''
    print -r -- 'I got you, future self!'
    print -r -- "Number of times I saved your a\$\$: $count"
    return 1
  fi

  command crontab "$@"
}

