diary() {
  local day title timestamp
  day=$(date '+%Y-%m-%d')
  title=$(date '+%B %d, %Y')
  timestamp=$(date '+%A, %H:%M')
  nvim "$HOME/Documents/vip/${day}.md" "+normal i${title}" "+normal o${timestamp}"
}
alias di='diary'
dit() {
  nvim "$HOME/Documents/vip/$(date '+%Y-%m-%d').md"
}
